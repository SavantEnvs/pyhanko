# Backport target (repro-4a33d05, mayhemheroes pyhanko/fuzz-pdf run 2 @ FUZZED cf07cbb6). The
# original mayhemheroes harness (mayhem/fuzz_pdf.py) picks between pyHanko's low-level PDF
# object-model reader (pyhanko.pdf_utils.reader.PdfFileReader) and the incremental-update writer
# (pyhanko.pdf_utils.incremental_writer.IncrementalPdfFileWriter, which itself constructs a
# PdfFileReader first) on one input bool, feeding the rest of the input as the whole PDF file
# body. The cmd binary is the compiled ELF launcher that drives mayhem/fuzz_pdf.py; Atheris
# instruments the pyhanko.pdf_utils modules so the run records coverage (edges).
project: savantenvs/pyhanko
target: fuzz-pdf-buggy-mhh-run-2

cmds:
  - cmd: /mayhem/pyhanko_fuzzer
    libfuzzer: true
    timeout: 12

# Seed corpus: the original mayhemheroes run's own coverage corpus (mayhem download
# mayhemheroes/pyhanko/fuzz-pdf/2) — the reproducer for the run's defects.
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/fuzz-pdf-buggy-mhh-run-2/testsuite
